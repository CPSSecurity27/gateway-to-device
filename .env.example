# ── Broker MQTT (TLS) ───────────────────────────────────────────────
# El GtD es el ÚNICO principal MQTT del lado servidor (ver README §Arquitectura).
GTD_MQTT_HOST=cpssecurity.com.ar
GTD_MQTT_PORT=8883
GTD_MQTT_USERNAME=gateway
GTD_MQTT_PASSWORD=            # SECRETO — inyectar por entorno, NUNCA commitear
GTD_MQTT_CA_FILE=            # opcional: CA propia. Vacío = bundle de CAs del sistema
GTD_MQTT_CLIENT_ID=gtd-1
GTD_MQTT_ROOT=av             # raíz de tópicos: av/<id>/<canal>

# ── Postgres ────────────────────────────────────────────────────────
# Vacío ⇒ StubRepo (in-memory + logs, sin base). El rol es cps_alarms: SOLO
# puede ejecutar las funciones del esquema gtd de la base del sistema web —
# el motor le niega el DML directo (contrato-gtd-postgres.md).
#
# IMPORTANTE: conexión DIRECTA a Postgres, sin pgbouncer. Si algún día hay
# pooler, el listener necesita un DSN directo aparte (LISTEN no sobrevive a un
# pooler en modo transaction, y falla de forma intermitente).
#
# Desarrollo local (base cps_security_v2 del repo system-web):
# GTD_PG_DSN=postgresql://cps_alarms:CpsAlarms2026!@localhost:5432/cps_security_v2
GTD_PG_DSN=

# Spool del canal `up`: eventos que no pudieron entrar a la base (el PUBACK ya
# salió, no existen en ningún otro lado). JSONL, drenado al recuperar la base.
GTD_SPOOL_PATH=var/spool-up.jsonl

# ── Presencia (ver src/gtd/pipeline/presencia.py) ───────────────────
# Silencio tras el cual un panel se marca offline. Generoso: sobre enlaces
# satelitales se midieron cortes de ~50s que NO son una falla.
GTD_PRESENCE_TIMEOUT_S=180
# Silencio previo para leer un status repetido como reconexión (takeover de
# sesión, donde el broker no publica el LWT).
GTD_RECONNECT_GAP_S=60

# ── Provisioner (proceso APARTE: python -m gtd.provisioner) ─────────
# Da de alta y de baja credenciales de panel en el broker. Corre con otro
# systemd unit (deploy/cps-provisioner.service) y otros privilegios: escribe
# /etc/mosquitto y recarga el servicio, cosas que el GtD no puede hacer.
#
# Los SALTS de derivación viven ACÁ y en ningún otro lado — quien los tiene
# puede calcular las credenciales de toda la flota. NUNCA van en el .env de la
# web. Se validan contra un vector conocido antes de registrar nada.
#
# Salen de AlarmaESP32V6/components/wifi_manager/wifi_secrets.local.h y tienen
# que ser IDÉNTICOS a los que se compilaron en el firmware. Si no matchean, las
# credenciales no abren el equipo.
#
# Equipo <-> broker. HMAC-SHA256 sobre la MAC STA.
GTD_SALT_MQTT=
# Portal local del equipo (192.168.4.1). djb2 sobre la MAC SoftAP (= STA + 1).
# El primero es del usuario `admin`, que va impreso en la etiqueta; el segundo
# del usuario `cps`, que no se imprime nunca.
GTD_SALT_TEC=
GTD_SALT_CPS=
# Alternativa para builds de laboratorio: password fija, no usa el salt.
GTD_PANEL_PASSWORD=
GTD_PROVISIONER_SCRIPT=deploy/provision-panel.sh

# Cifrado de las credenciales del portal antes de guardarlas en `device`.
# base64 de 32 bytes; la COMPARTE con el backend web (CPS_CRED_KEY allá), que
# descifra para mostrarlas. Es lo único de este bloque que la web también tiene.
#   openssl rand -base64 32
GTD_CRED_KEY=

# Al arrancar, revocar credenciales de equipos que ya no existen: un alta de
# fábrica que falló a mitad de camino las deja registradas y nadie las mira.
GTD_BARRER_HUERFANOS=true

# ── Puente con la app VIEJA (python -m gtd.legacy) ──────────────────
# TEMPORAL: se va con la app vieja. Ver docs/09-app-vieja.md.
#
# Habla el listener 1883 EN CLARO Y ANÓNIMO, no el 8883 del GtD: es el único
# que la app vieja sabe hablar (host y puerto están compilados adentro del APK).
GTD_LEGACY_MQTT_HOST=localhost
GTD_LEGACY_MQTT_PORT=1883
GTD_LEGACY_TOPIC=cliente/servidor

# Rol `cps_legacy`: EXECUTE sobre gtd.enqueue_legacy_alarm y NADA más — ni
# siquiera SELECT sobre `device`. VACÍO = se aceptan los mensajes y se tiran
# (el proceso avisa fuerte al arrancar). NO cae a GTD_PG_DSN a propósito: ese
# es el rol del GtD, y la entrada de este proceso viene de internet sin
# autenticar.
# GTD_LEGACY_DSN=postgresql://cps_legacy:CpsLegacy2026!@localhost:5432/cps_security_v2
GTD_LEGACY_DSN=

# Freno anti-abuso: el 1883 es anónimo y la app vieja no autentica a nadie, así
# que cualquiera puede publicar a nombre de cualquier DNI. Segundos mínimos
# entre activaciones del mismo DNI, y tope global por minuto.
# El cps999 (desactivar) NUNCA se frena: una sirena que no se puede apagar es
# peor que una que suena de más.
GTD_LEGACY_FRENO_DNI_S=3
GTD_LEGACY_FRENO_GLOBAL_POR_MIN=30

# La BAJADA: proyección a Firebase + push. Service account de `cpssecurityapp`,
# que es el proyecto que lee la app vieja. VACÍO = la app puede ACTIVAR pero sus
# pantallas quedan congeladas en lo último que escribió el broker-bridge.
GTD_LEGACY_SA_FILE=
GTD_LEGACY_RTDB_URL=https://cpssecurityapp-default-rtdb.firebaseio.com

# PREFIJO DE ENSAYO. Vacío = PRODUCCIÓN, o sea los paths que los teléfonos de
# los vecinos están escuchando AHORA MISMO. Poniendo algo (ej. `_ensayo`) todo
# se escribe abajo de ese nodo y no lo ve nadie: es la única forma de probar sin
# mostrarle una activación falsa a un barrio entero.
GTD_LEGACY_RTDB_PREFIJO=

# El push es lo ÚNICO que hoy le avisa a un vecino que sonó la alarma. Apagable
# aparte para poder ensayar la proyección sin notificar a nadie.
GTD_LEGACY_PUSH=true

# Reconciliación: LISTEN/NOTIFY no tiene memoria, y sin barrido un reinicio en
# el momento equivocado deja la app diciendo 'Conectada' con una emergencia
# abierta. El catálogo va mucho más lento: cambia con altas, no con emergencias.
GTD_LEGACY_BARRIDO_S=30
GTD_LEGACY_CLIENTES_S=300

# ── Observabilidad ──────────────────────────────────────────────────
GTD_LOG_LEVEL=INFO
