# ── Broker MQTT (TLS) ───────────────────────────────────────────────
# El GtD es el ÚNICO principal MQTT del lado servidor (ver README §Arquitectura).
GTD_MQTT_HOST=cpssecurity.com.ar
GTD_MQTT_PORT=8883
GTD_MQTT_USERNAME=gateway
GTD_MQTT_PASSWORD=            # SECRETO — inyectar por entorno, NUNCA commitear
GTD_MQTT_CA_FILE=            # opcional: CA propia. Vacío = bundle de CAs del sistema
GTD_MQTT_CLIENT_ID=gtd-1
GTD_MQTT_ROOT=av             # raíz de tópicos: av/<id>/<canal>

# ── Postgres ────────────────────────────────────────────────────────
# Vacío ⇒ StubRepo (in-memory + logs, sin base). El rol es cps_alarms: SOLO
# puede ejecutar las funciones del esquema gtd de la base del sistema web —
# el motor le niega el DML directo (contrato-gtd-postgres.md).
#
# IMPORTANTE: conexión DIRECTA a Postgres, sin pgbouncer. Si algún día hay
# pooler, el listener necesita un DSN directo aparte (LISTEN no sobrevive a un
# pooler en modo transaction, y falla de forma intermitente).
#
# Desarrollo local (base cps_security_v2 del repo system-web):
# GTD_PG_DSN=postgresql://cps_alarms:CpsAlarms2026!@localhost:5432/cps_security_v2
GTD_PG_DSN=

# Spool del canal `up`: eventos que no pudieron entrar a la base (el PUBACK ya
# salió, no existen en ningún otro lado). JSONL, drenado al recuperar la base.
GTD_SPOOL_PATH=var/spool-up.jsonl

# ── Presencia (ver src/gtd/pipeline/presencia.py) ───────────────────
# Silencio tras el cual un panel se marca offline. Generoso: sobre enlaces
# satelitales se midieron cortes de ~50s que NO son una falla.
GTD_PRESENCE_TIMEOUT_S=180
# Silencio previo para leer un status repetido como reconexión (takeover de
# sesión, donde el broker no publica el LWT).
GTD_RECONNECT_GAP_S=60

# ── Observabilidad ──────────────────────────────────────────────────
GTD_LOG_LEVEL=INFO
